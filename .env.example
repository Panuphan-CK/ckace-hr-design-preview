# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=8080
CKACE_RUNTIME_STAGE=local
# Coarse runtime safety marker for compatibility routing.
CKACE_MODULE_ROUTING=LEGACY
# DEV/TEST-only per-route authority JSON. Omit for all-LEGACY.
# Example: {"LEAVE_READ":"NEW","LEAVE_WRITE":"NEW"}
CKACE_MODULE_ROUTING_STATE=
# Comma-separated modules whose WRITE routes must fail closed with HTTP 503.
# Example: LEAVE,MEDICAL
CKACE_MODULE_WRITE_FREEZE=
DATABASE_URL=postgresql://ckace_hr:change-me@localhost:5432/ckace_hr

# Internal compatibility bridge. Store the real value in managed secret
# configuration for hosted environments, never in source.
CKACE_LEGACY_BRIDGE_SECRET=

# CKACE HR Desktop browser session signing. Hosted TEST/Production should
# use a managed secret of at least 32 bytes.
CKACE_DESKTOP_SESSION_SECRET=
# Required only while authenticating migrated Legacy Desktop password hashes.
# Never commit the real salt.
CKACE_LEGACY_PASSWORD_SALT=

# LINE Login channel identifier. This is configuration, not an authorization
# authority; actor identity remains server-derived.
LINE_LOGIN_CHANNEL_ID=

# M5 private R2 storage. Never put real access keys in this file.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_BUCKET_NAME=ckace-hr-test-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

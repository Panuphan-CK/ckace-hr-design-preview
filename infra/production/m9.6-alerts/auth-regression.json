{
  "displayName": "CKACE HR PROD - Auth Regression",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "Signed-out /api/profile/me must return 401. Any other result indicates an authorization regression.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Signed-out auth guard check failed",
      "conditionThreshold": {
        "filter": "metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type = \"uptime_url\" AND metric.label.check_id = \"ckace-hr-prod-auth-guard-TvS9_vDPYq8\"",
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "60s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER"
          }
        ]
      }
    }
  ]
}

{
  "displayName": "CKACE HR PROD - Health Failure",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "Firebase-front-door /api/health check failed. Investigate or rollback staging before user cutover.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Health uptime failed",
      "conditionThreshold": {
        "filter": "metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type = \"uptime_url\" AND metric.label.check_id = \"ckace-hr-prod-health-UXbVs-AuroM\"",
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "60s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER"
          }
        ]
      }
    }
  ]
}

{
  "displayName": "CKACE HR PROD - Latency Regression",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "API p95 request latency exceeds 3 seconds for 10 minutes. Hold cutover and investigate.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "API p95 > 3s for 10m",
      "conditionThreshold": {
        "filter": "metric.type = \"run.googleapis.com/request_latencies\" AND resource.type = \"cloud_run_revision\" AND resource.label.service_name = \"ckace-hr-api-prod\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3000,
        "duration": "600s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ]
      }
    }
  ]
}

{
  "displayName": "CKACE HR PROD - Revision Not Ready",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "Cloud Run PROD revision/platform error. Hold staging/cutover and investigate before exposing user traffic.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Cloud Run PROD revision error",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND (resource.labels.service_name=\"ckace-hr-api-prod\" OR resource.labels.service_name=\"ckace-hr-web-prod\") AND severity>=ERROR"
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    },
    "autoClose": "1800s"
  }
}
